-- Joriy (kirgan) foydalanuvchi profilining local keshi.
-- Egasi: `:dev:feature:profile` moduli (UserEntity — sessiya, bu esa profil).
-- Bitta qatordan iborat: offline ishlash uchun.
CREATE TABLE ProfileEntity (
    uid TEXT NOT NULL PRIMARY KEY,
    firstName TEXT,
    lastName TEXT,
    phoneNumber TEXT,
    role TEXT,
    universityId TEXT,
    universityEmail TEXT,
    birthYear INTEGER,
    courseYear TEXT,
    -- MALE | FEMALE — `GET /v1/students?gender=` filtri aynan shu maydonga tayanadi.
    gender TEXT,
    -- EVERYONE | CONNECTIONS (sukut) | NOBODY — kim `online`/`lastSeenAt` ni ko'radi.
    lastSeenVisibility TEXT,
    -- Profil rasmining URL manzili (POST /v1/profile/me/avatar qaytaradi)
    avatarUrl TEXT,
    -- Biznes egasi profili (rol BUSINESS bo'lganda)
    businessName TEXT,
    businessType TEXT,
    email TEXT,
    -- Tarjimayi hol (140 belgi). Havola/`@handle`/telefon SERVERDA rad etiladi
    -- (`422 BIO_NOT_ALLOWED`), shuning uchun bu yerda doim oddiy matn.
    bio TEXT,
    -- EVERYONE | CONNECTIONS | NOBODY (sukut) — raqamni kim ko'radi.
    -- `lastSeenVisibility` dan MUSTAQIL sozlama.
    phoneVisibility TEXT,
    -- Yashash manzili — ish e'lonlari digestining geo yarmi shunga tayanadi
    -- (`02-PUSH_CATALOG_RESPONSE.md` §4). Id'lar e'lon geo katalogi bilan bir fazoda.
    regionId TEXT,
    districtId TEXT
);

selectCurrent:
SELECT * FROM ProfileEntity LIMIT 1;

upsert:
INSERT OR REPLACE INTO ProfileEntity(
    uid, firstName, lastName, phoneNumber, role, universityId, universityEmail, birthYear, courseYear,
    gender, lastSeenVisibility, avatarUrl, businessName, businessType, email, bio, phoneVisibility,
    regionId, districtId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

clear:
DELETE FROM ProfileEntity;
