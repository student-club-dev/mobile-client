-- Katalog GURUHI (`POST /v1/catalog/groups`) — bosh ekrandagi bo'limlar shu jadvaldan
-- yasaladi: sarlavha, emoji, rang va tartib serverdan keladi, ilovada qat'iy ro'yxat yo'q.
-- Guruh ichida biznes turlari turadi (`DiscountCategoryEntity.groupKey`).
CREATE TABLE DiscountGroupEntity (
    key TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    emoji TEXT NOT NULL,
    accent INTEGER NOT NULL,
    sortOrder INTEGER NOT NULL
);

CREATE TABLE DiscountCategoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    emoji TEXT NOT NULL,
    offerCount INTEGER NOT NULL,
    accent INTEGER NOT NULL,
    -- Tur qaysi guruhga tegishli (`CatalogTypeDto.groupKey`). '' — noma'lum (eski kesh).
    groupKey TEXT NOT NULL DEFAULT ''
);

CREATE TABLE DiscountOfferEntity (
    id TEXT NOT NULL PRIMARY KEY,
    categoryId TEXT NOT NULL,
    -- E'lon qaysi bosh bo'limga tushishini AYNAN shu ustun hal qiladi (kalit so'z bilan
    -- taxmin qilinmaydi). '' — guruhsiz, bosh ekranda ko'rinmaydi.
    groupKey TEXT NOT NULL DEFAULT '',
    subcategory TEXT NOT NULL DEFAULT '',
    gender TEXT NOT NULL DEFAULT '',
    merchant TEXT NOT NULL,
    title TEXT NOT NULL,
    isDiscount INTEGER NOT NULL DEFAULT 1,
    discountPercent INTEGER NOT NULL,
    originalPrice INTEGER NOT NULL DEFAULT 0,
    finalPrice INTEGER NOT NULL DEFAULT 0,
    priceUnit TEXT NOT NULL DEFAULT 'dona',
    tag TEXT NOT NULL,
    promoCode TEXT,
    location TEXT,
    expiry TEXT,
    emoji TEXT NOT NULL,
    bannerAccent INTEGER NOT NULL,
    featured INTEGER NOT NULL,
    lat REAL NOT NULL DEFAULT 0.0,
    lng REAL NOT NULL DEFAULT 0.0,
    -- Karta rasmi (`DiscountCardDto.imageUrl`). NULL — rasm yo'q, UI emoji chizadi.
    imageUrl TEXT
);

CREATE TABLE SavedDiscountEntity (
    offerId TEXT NOT NULL PRIMARY KEY
);

selectGroups:
SELECT * FROM DiscountGroupEntity ORDER BY sortOrder;

selectCategories:
SELECT * FROM DiscountCategoryEntity;

selectAllOffers:
SELECT * FROM DiscountOfferEntity;

selectOfferById:
SELECT * FROM DiscountOfferEntity WHERE id = ?;

selectOffersByCategory:
SELECT * FROM DiscountOfferEntity WHERE categoryId = ?;

selectFeaturedOffers:
SELECT * FROM DiscountOfferEntity WHERE featured = 1;

selectSavedOffers:
SELECT o.* FROM DiscountOfferEntity o
INNER JOIN SavedDiscountEntity s ON s.offerId = o.id;

countCategories:
SELECT count(*) FROM DiscountCategoryEntity;

upsertGroup:
INSERT OR REPLACE INTO DiscountGroupEntity(key, name, emoji, accent, sortOrder)
VALUES (?, ?, ?, ?, ?);

upsertCategory:
INSERT OR REPLACE INTO DiscountCategoryEntity(id, name, emoji, offerCount, accent, groupKey)
VALUES (?, ?, ?, ?, ?, ?);

upsertOffer:
INSERT OR REPLACE INTO DiscountOfferEntity(
    id, categoryId, groupKey, subcategory, gender, merchant, title, isDiscount, discountPercent,
    originalPrice, finalPrice, priceUnit, tag, promoCode, location, expiry, emoji, bannerAccent, featured, lat, lng,
    imageUrl
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

saveOffer:
INSERT OR REPLACE INTO SavedDiscountEntity(offerId) VALUES (?);

unsaveOffer:
DELETE FROM SavedDiscountEntity WHERE offerId = ?;

clearGroups:
DELETE FROM DiscountGroupEntity;

clearCategories:
DELETE FROM DiscountCategoryEntity;

clearOffers:
DELETE FROM DiscountOfferEntity;
