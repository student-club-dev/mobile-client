-- Chat local keshi (offline-first). Manba — backend: REST tarix + `/chat` WebSocket.
--
-- Kesh **ko'zgu**, haqiqat manbai emas: tartib `seq` bo'yicha takrorlanadi (`createdAt`
-- EMAS — bir xil millisekundda ikki xabar bo'lishi mumkin). Yuborilayotgan xabar ham shu
-- yerda turadi (`status = SENDING`), uning `seq` i vaqtincha 0 — ack kelganda haqiqiysiga
-- almashadi.
--
-- `archived` — **faqat local**: backendda arxivlash endpointi yo'q (chat.md §14).

CREATE TABLE ConversationEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL DEFAULT 'DIRECT',
    -- Oxirgi xabar vaqti (epoch ms). Xabar yozilmagan suhbatda NULL.
    lastMessageAt INTEGER,

    -- Ikkinchi tomon (StudentSummary). `online`/`lastSeenAt` — haqiqiy qiymat; suhbatdosh
    -- `lastSeenVisibility = NOBODY` qo'ygan bo'lsa server false/null yuboradi.
    otherId TEXT NOT NULL,
    otherUsername TEXT,
    otherFullName TEXT,
    otherAvatarUrl TEXT,
    otherOnline INTEGER NOT NULL DEFAULT 0,
    otherLastSeenAt INTEGER,
    -- Suhbatdosh profili (chat ichidagi profil ekrani uchun). Serverdan `StudentSummaryDto`
    -- da allaqachon keladi; `universityId` — ERKIN satr (`emis-142`), katalog yo'q.
    otherUniversityId TEXT,
    otherGender TEXT,
    otherCourseYear TEXT,

    -- Ro'yxatdagi ko'rinish uchun oxirgi xabarning nusxasi.
    lastMessageBody TEXT,
    lastMessageSenderId TEXT,
    -- Oxirgi xabarning turi. Media xabarda tana BO'SH (server `body` ni faqat TEXT va
    -- izohli rasm uchun to'ldiradi), shuning uchun turni bilmasak ro'yxatda "📷 Rasm"
    -- o'rniga bo'sh qator ko'rinardi. Eski keshdagi qatorlarda NULL — o'shanda tur
    -- tanadan taxmin qilinadi (`MediaContent`).
    lastMessageType TEXT,
    -- Oxirgi xabar o'chirilganmi (soft delete). Tanasi haqiqatan bo'shatilgani uchun
    -- busiz ro'yxatda "Xabar yozing…" ko'rinardi.
    lastMessageDeleted INTEGER NOT NULL DEFAULT 0,

    unreadCount INTEGER NOT NULL DEFAULT 0,
    -- Men o'qigan eng yuqori seq — qayta ulanishda `?after=` shundan boshlanadi.
    lastReadSeq INTEGER NOT NULL DEFAULT 0,
    -- Suhbatdosh o'qigan eng yuqori seq — chiquvchi xabardagi ikki belgichaning rangi
    -- shunga qarab. Manba: WS `message:read` va `GET /v1/conversations` (`peerReadSeq`).
    otherReadSeq INTEGER NOT NULL DEFAULT 0,
    -- Suhbatdoshning qurilmasi qabul qilgan eng yuqori seq (WS `message:delivered` va
    -- `peerDeliveredSeq`) — bitta belgicha ikkitaga aynan shunda aylanadi.
    otherDeliveredSeq INTEGER NOT NULL DEFAULT 0,
    archived INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE MessageEntity (
    id TEXT NOT NULL PRIMARY KEY,
    conversationId TEXT NOT NULL,
    senderId TEXT NOT NULL,
    -- Suhbat ichidagi tartib raqami: 1 dan boshlanadi, bo'shliqsiz. Yuborilmagan
    -- (optimistik) xabarda 0 — ro'yxat oxirida turadi.
    seq INTEGER NOT NULL DEFAULT 0,
    type TEXT NOT NULL DEFAULT 'TEXT',
    body TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    -- Idempotentlik kaliti (C6): qayta yuborishda server yangi xabar yaratmaydi.
    clientMsgId TEXT,
    -- SENDING | SENT | FAILED
    status TEXT NOT NULL DEFAULT 'SENT',

    -- Xabar o'chirilgan vaqti (epoch ms). Qator O'CHIRILMAYDI: `seq` — tarix, o'qildi va
    -- o'qilmaganlar arifmetikasining o'qi, uni yo'q qilish hammasida teshik qoldirardi
    -- (`handoff/api-changes.md` §4b). Tanasi bo'shatiladi, ekranda tombstone chiziladi.
    deletedAt INTEGER,

    -- Media biriktirmasi — `MessageDto.attachment` ning ko'zgusi (`handoff/chat.md`).
    -- `attachmentId` = server `mediaId`: biriktirma BIR MARTALIK, shuning uchun yiqilgan
    -- xabarni qayta yuborishda uni qaytadan yuklamaymiz (422 MEDIA_ALREADY_USED).
    attachmentId TEXT,
    attachmentUrl TEXT,
    attachmentThumbUrl TEXT,
    -- 0 — o'lcham noma'lum (ovoz/fayl uchun server qaytarmaydi); UI kvadrat nisbatga tushadi.
    attachmentWidth INTEGER NOT NULL DEFAULT 0,
    attachmentHeight INTEGER NOT NULL DEFAULT 0,
    -- IMAGE | GIF | VIDEO | VOICE | FILE
    attachmentKind TEXT,
    -- PROCESSING | READY | FAILED. PROCESSING — video hali transkodlanmoqda; tugagach
    -- WS `media:ready` shu qatorni to'ldiradi.
    attachmentStatus TEXT,
    attachmentMime TEXT,
    attachmentSizeBytes INTEGER,
    attachmentDurationMs INTEGER,
    -- Ovozli xabarning 48 nuqtali to'lqin shakli, vergul bilan ajratilgan (`0..100`).
    -- JSON emas: qiymatlar oddiy sonlar va SQLDelight'da massiv ustuni yo'q.
    attachmentWaveform TEXT,
    -- FILE uchun asl nom (server tozalagan holda).
    attachmentFileName TEXT,
    attachmentBlurHash TEXT,
    -- 1 bo'lsa ovozsiz va takrorlanuvchi qilib o'ynatiladi (GIF va GIF'dan o'girilgan MP4).
    attachmentIsAnimated INTEGER,

    -- STICKER xabarida `body` TAQIQLANGAN, shuning uchun ko'rsatiladigan hamma narsa
    -- shu ustunlarda: emoji (rasm bo'lmasa) va serverdagi tasviri.
    stickerId TEXT,
    stickerEmoji TEXT,
    stickerUrl TEXT,

    -- Bir martada yuborilgan rasmlarni bog'laydi. 2026-07-29 dan SERVER qaytaradi
    -- (`MessageDto.albumId`) — ya'ni qabul qiluvchi tomonda ham to'g'ri to'r chiziladi.
    -- Eski keshdagi qatorlarda NULL bo'lishi mumkin; o'shanda albom qo'shni xabarlardan
    -- taxmin qilinadi (ChatViewModel).
    albumId TEXT
);

CREATE INDEX message_conversation_idx ON MessageEntity(conversationId, seq);

-- --- Suhbatlar --------------------------------------------------------------------------

-- Tartib: yangi faol suhbat tepada. NULL (hali xabar yozilmagan) ENG PASTDA — backend
-- ularni tepaga chiqaradi (PostgreSQL `DESC` da NULL birinchi), bu yerda tuzatiladi.
selectConversations:
SELECT * FROM ConversationEntity
WHERE archived = 0
ORDER BY lastMessageAt IS NULL, lastMessageAt DESC;

selectArchivedConversations:
SELECT * FROM ConversationEntity
WHERE archived = 1
ORDER BY lastMessageAt IS NULL, lastMessageAt DESC;

selectConversation:
SELECT * FROM ConversationEntity WHERE id = ?;

countConversations:
SELECT count(*) FROM ConversationEntity;

-- Suhbatni serverdan kelgan ma'lumot bilan yangilash IKKI qadamda bajariladi
-- (`INSERT … ON CONFLICT` — SQLite 3.24+, Android 7 da esa 3.9 bor; `INSERT OR REPLACE`
-- bo'lsa local ustunlar — `archived`, `lastReadSeq` — yo'qolardi).
--
-- 1) qator bo'lmasa yaratamiz, 2) local ustunlarga TEGMASDAN yangilaymiz.
insertConversationIfNew:
INSERT OR IGNORE INTO ConversationEntity(
    id, type, lastMessageAt,
    otherId, otherUsername, otherFullName, otherAvatarUrl, otherOnline, otherLastSeenAt,
    otherUniversityId, otherGender, otherCourseYear,
    lastMessageBody, lastMessageSenderId, lastMessageType, lastMessageDeleted,
    unreadCount, lastReadSeq, otherReadSeq, otherDeliveredSeq
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateConversation:
UPDATE ConversationEntity SET
    type = ?,
    lastMessageAt = ?,
    otherId = ?,
    otherUsername = ?,
    otherFullName = ?,
    otherAvatarUrl = ?,
    otherOnline = ?,
    otherLastSeenAt = ?,
    otherUniversityId = ?,
    otherGender = ?,
    otherCourseYear = ?,
    lastMessageBody = ?,
    lastMessageSenderId = ?,
    lastMessageType = ?,
    lastMessageDeleted = ?,
    unreadCount = ?,
    -- Kursorlar ORTGA surilmasin: WS orqali allaqachon oldinga ketgan bo'lishi mumkin.
    lastReadSeq = max(lastReadSeq, :lastReadSeq),
    otherReadSeq = max(otherReadSeq, :otherReadSeq),
    otherDeliveredSeq = max(otherDeliveredSeq, :otherDeliveredSeq)
WHERE id = :id;

-- WS `message:new` — ro'yxatdagi qatorni yangilaydi (suhbat allaqachon keshda bo'lsa).
-- Yangi xabar kelgani uchun `lastMessageDeleted` doim nolga qaytadi.
touchConversation:
UPDATE ConversationEntity
SET lastMessageBody = ?, lastMessageSenderId = ?, lastMessageType = ?, lastMessageDeleted = 0,
    lastMessageAt = ?, unreadCount = unreadCount + ?
WHERE id = ?;

-- Oxirgi xabar o'chirilganda (`message:deleted` yoki o'zimiz o'chirganda): ro'yxatdagi
-- ko'rinish tombstone'ga aylanadi. Vaqt va jo'natuvchi joyida qoladi — xabar tarixdan
-- yo'qolmaydi, faqat matni ko'rinmaydi.
setLastMessageDeleted:
UPDATE ConversationEntity SET lastMessageBody = '', lastMessageDeleted = 1 WHERE id = ?;

-- O'chirilgan xabar o'qilmaganlar sanog'idan chiqadi: ko'rinmaydigan xabarni o'qib
-- bo'lmaydi, aks holda badge abadiy yoqiq qolardi (`handoff/api-changes.md` §4b).
-- Faqat hali o'qilmagan (`seq > lastReadSeq`) xabar sanoqni kamaytiradi.
decrementUnreadForDeleted:
UPDATE ConversationEntity
SET unreadCount = max(0, unreadCount - 1)
WHERE id = :id AND :seq > lastReadSeq;

-- WS `presence:update` — onlayn holati (bir odam bir nechta suhbatda bo'lishi mumkin emas,
-- lekin so'rov baribir `otherId` bo'yicha ketadi).
setPresence:
UPDATE ConversationEntity SET otherOnline = ?, otherLastSeenAt = ? WHERE otherId = ?;

markRead:
UPDATE ConversationEntity SET unreadCount = 0, lastReadSeq = max(lastReadSeq, ?) WHERE id = ?;

-- WS `message:read` (server → klient) — suhbatdosh qayergacha o'qigani.
setOtherReadSeq:
UPDATE ConversationEntity SET otherReadSeq = max(otherReadSeq, ?) WHERE id = ?;

-- WS `message:delivered` (server → klient) — suhbatdoshning qurilmasi qayergacha olgani.
setOtherDeliveredSeq:
UPDATE ConversationEntity SET otherDeliveredSeq = max(otherDeliveredSeq, ?) WHERE id = ?;

setArchived:
UPDATE ConversationEntity SET archived = ? WHERE id = ?;

deleteConversation:
DELETE FROM ConversationEntity WHERE id = ?;

clearConversations:
DELETE FROM ConversationEntity;

-- --- Xabarlar ---------------------------------------------------------------------------

-- Eskidan yangiga. Yuborilayotgani (`seq = 0`) eng oxirida.
selectMessages:
SELECT * FROM MessageEntity
WHERE conversationId = ?
ORDER BY (seq = 0), seq ASC, createdAt ASC;

-- Tarixni yuqoriga yuklash kursori (`?before=`). `min()`/`max()` o'rniga ORDER BY + LIMIT:
-- agregat ustun SQLDelight'da qo'shimcha o'rov klass hosil qiladi, bu esa oddiy `Long?`.
minSeq:
SELECT seq FROM MessageEntity WHERE conversationId = ? AND seq > 0 ORDER BY seq ASC LIMIT 1;

-- Qayta ulanishda yetishib olish kursori (`?after=`).
maxSeq:
SELECT seq FROM MessageEntity WHERE conversationId = ? ORDER BY seq DESC LIMIT 1;

selectMessageById:
SELECT * FROM MessageEntity WHERE id = ?;

upsertMessage:
INSERT OR REPLACE INTO MessageEntity(
    id, conversationId, senderId, seq, type, body, createdAt, clientMsgId, status, deletedAt,
    attachmentId, attachmentUrl, attachmentThumbUrl, attachmentWidth, attachmentHeight,
    attachmentKind, attachmentStatus, attachmentMime, attachmentSizeBytes, attachmentDurationMs,
    attachmentWaveform, attachmentFileName, attachmentBlurHash, attachmentIsAnimated,
    stickerId, stickerEmoji, stickerUrl, albumId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setMessageStatus:
UPDATE MessageEntity SET status = ? WHERE id = ?;

-- Fayl yuklanib bo'lgach (`POST /v1/media/chat-upload`) va WS `media:ready` kelganda:
-- optimistik qatorning biriktirmasi to'ldiriladi. Qator o'chirilmaydi — `id` o'zgarmagani
-- uchun ekranda sakrash bo'lmaydi va `clientMsgId` joyida qolib, server javobiga moslik
-- buzilmaydi. `attachmentId` saqlanishi shart: qayta yuborishda fayl QAYTA yuklanmaydi.
setMessageAttachment:
UPDATE MessageEntity SET
    attachmentId = ?,
    attachmentUrl = ?,
    attachmentThumbUrl = ?,
    attachmentWidth = ?,
    attachmentHeight = ?,
    attachmentKind = ?,
    attachmentStatus = ?,
    attachmentMime = ?,
    attachmentSizeBytes = ?,
    attachmentDurationMs = ?,
    attachmentWaveform = ?,
    attachmentFileName = ?,
    attachmentBlurHash = ?,
    attachmentIsAnimated = ?
WHERE id = ?;

-- Soft delete (`DELETE /v1/messages/{id}` va WS `message:deleted`). Tana **haqiqatan**
-- bo'shatiladi — faqat DTO darajasida yashirish jo'natuvchiga yolg'on bo'lardi.
-- Biriktirma havolalari ham tozalanadi: server fayllarni ham o'chiradi.
setMessageDeleted:
UPDATE MessageEntity SET
    body = '',
    deletedAt = ?,
    attachmentId = NULL,
    attachmentUrl = NULL,
    attachmentThumbUrl = NULL,
    stickerId = NULL,
    stickerEmoji = NULL,
    stickerUrl = NULL
WHERE id = ?;

-- Optimistik qator ack kelganda serverning haqiqiy id/seq'iga almashadi.
deleteMessage:
DELETE FROM MessageEntity WHERE id = ?;

-- `message:new` o'z xabarimiz bo'lib qaytganda optimistik nusxani olib tashlaydi (ack'dan
-- OLDIN kelgan holat uchun — ack kelsa `deleteMessage` + `upsertMessage` shu ishni qiladi).
--
-- Moslik **`clientMsgId` bo'yicha**: backend 2026-07-29 dan uni `message:new` da
-- jo'natuvchining o'z qurilmalariga qaytaradi (`handoff/chat.md`). Avval moslik matn
-- bo'yicha edi va ikki joyda buzilardi: ketma-ket ikkita bir xil matnda NOTO'G'RI qator
-- o'chirilardi, media xabarda esa tana bo'sh bo'lib usul umuman ishlamasdi.
--
-- `status = 'SENDING'` sharti ack allaqachon almashtirgan HAQIQIY qatorni himoya qiladi:
-- u ham o'sha `clientMsgId` ni saqlaydi (qayta yuborish uchun kerak).
deleteSendingByClientMsgId:
DELETE FROM MessageEntity
WHERE conversationId = ? AND status = 'SENDING' AND clientMsgId = ?;

clearConversationMessages:
DELETE FROM MessageEntity WHERE conversationId = ?;

clearMessages:
DELETE FROM MessageEntity;
