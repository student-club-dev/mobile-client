-- Chat local keshi (offline-first). Manba — backend: REST tarix + `/chat` WebSocket.
--
-- Kesh **ko'zgu**, haqiqat manbai emas: tartib `seq` bo'yicha takrorlanadi (`createdAt`
-- EMAS — bir xil millisekundda ikki xabar bo'lishi mumkin). Yuborilayotgan xabar ham shu
-- yerda turadi (`status = SENDING`), uning `seq` i vaqtincha 0 — ack kelganda haqiqiysiga
-- almashadi.
--
-- `archived` — **faqat local**: backendda arxivlash endpointi yo'q (chat.md §14).

CREATE TABLE ConversationEntity (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL DEFAULT 'DIRECT',
    -- Oxirgi xabar vaqti (epoch ms). Xabar yozilmagan suhbatda NULL.
    lastMessageAt INTEGER,

    -- Ikkinchi tomon (StudentSummary). `online`/`lastSeenAt` — haqiqiy qiymat; suhbatdosh
    -- `lastSeenVisibility = NOBODY` qo'ygan bo'lsa server false/null yuboradi.
    otherId TEXT NOT NULL,
    otherUsername TEXT,
    otherFullName TEXT,
    otherAvatarUrl TEXT,
    otherOnline INTEGER NOT NULL DEFAULT 0,
    otherLastSeenAt INTEGER,
    -- Suhbatdosh profili (chat ichidagi profil ekrani uchun). Serverdan `StudentSummaryDto`
    -- da allaqachon keladi; `universityId` — ERKIN satr (`emis-142`), katalog yo'q.
    otherUniversityId TEXT,
    otherGender TEXT,
    otherCourseYear TEXT,

    -- Ro'yxatdagi ko'rinish uchun oxirgi xabarning nusxasi.
    lastMessageBody TEXT,
    lastMessageSenderId TEXT,

    unreadCount INTEGER NOT NULL DEFAULT 0,
    -- Men o'qigan eng yuqori seq — qayta ulanishda `?after=` shundan boshlanadi.
    lastReadSeq INTEGER NOT NULL DEFAULT 0,
    -- Suhbatdosh o'qigan eng yuqori seq — chiquvchi xabardagi ikki belgichaning rangi
    -- shunga qarab. Manba: WS `message:read` va `GET /v1/conversations` (`peerReadSeq`).
    otherReadSeq INTEGER NOT NULL DEFAULT 0,
    -- Suhbatdoshning qurilmasi qabul qilgan eng yuqori seq (WS `message:delivered` va
    -- `peerDeliveredSeq`) — bitta belgicha ikkitaga aynan shunda aylanadi.
    otherDeliveredSeq INTEGER NOT NULL DEFAULT 0,
    archived INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE MessageEntity (
    id TEXT NOT NULL PRIMARY KEY,
    conversationId TEXT NOT NULL,
    senderId TEXT NOT NULL,
    -- Suhbat ichidagi tartib raqami: 1 dan boshlanadi, bo'shliqsiz. Yuborilmagan
    -- (optimistik) xabarda 0 — ro'yxat oxirida turadi.
    seq INTEGER NOT NULL DEFAULT 0,
    type TEXT NOT NULL DEFAULT 'TEXT',
    body TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    -- Idempotentlik kaliti (C6): qayta yuborishda server yangi xabar yaratmaydi.
    clientMsgId TEXT,
    -- SENDING | SENT | FAILED
    status TEXT NOT NULL DEFAULT 'SENT',

    -- Media biriktirmasi. Backend tipli xabarni hali qo'llab-quvvatlamaydi, shuning uchun
    -- `type`/`attachmentUrl` KLIENT tomonida aniqlanadi: tanasi rasm havolasi bo'lgan
    -- xabar — IMAGE, yakka emoji — STICKER (CHAT_MEDIA_AND_CALLS_BACKEND.md §0).
    attachmentUrl TEXT,
    attachmentThumbUrl TEXT,
    -- 0 — o'lcham noma'lum (server qaytarmaydi); UI kvadrat nisbatga tushadi.
    attachmentWidth INTEGER NOT NULL DEFAULT 0,
    attachmentHeight INTEGER NOT NULL DEFAULT 0,
    -- Bir martada yuborilgan rasmlarni bog'laydi. Faqat SHU qurilmada to'ladi — server
    -- `albumId` ni qaytarmaydi, qabul qiluvchi tomonda albom qo'shni xabarlardan taxmin
    -- qilinadi (ChatViewModel).
    albumId TEXT
);

CREATE INDEX message_conversation_idx ON MessageEntity(conversationId, seq);

-- --- Suhbatlar --------------------------------------------------------------------------

-- Tartib: yangi faol suhbat tepada. NULL (hali xabar yozilmagan) ENG PASTDA — backend
-- ularni tepaga chiqaradi (PostgreSQL `DESC` da NULL birinchi), bu yerda tuzatiladi.
selectConversations:
SELECT * FROM ConversationEntity
WHERE archived = 0
ORDER BY lastMessageAt IS NULL, lastMessageAt DESC;

selectArchivedConversations:
SELECT * FROM ConversationEntity
WHERE archived = 1
ORDER BY lastMessageAt IS NULL, lastMessageAt DESC;

selectConversation:
SELECT * FROM ConversationEntity WHERE id = ?;

countConversations:
SELECT count(*) FROM ConversationEntity;

-- Suhbatni serverdan kelgan ma'lumot bilan yangilash IKKI qadamda bajariladi
-- (`INSERT … ON CONFLICT` — SQLite 3.24+, Android 7 da esa 3.9 bor; `INSERT OR REPLACE`
-- bo'lsa local ustunlar — `archived`, `lastReadSeq` — yo'qolardi).
--
-- 1) qator bo'lmasa yaratamiz, 2) local ustunlarga TEGMASDAN yangilaymiz.
insertConversationIfNew:
INSERT OR IGNORE INTO ConversationEntity(
    id, type, lastMessageAt,
    otherId, otherUsername, otherFullName, otherAvatarUrl, otherOnline, otherLastSeenAt,
    otherUniversityId, otherGender, otherCourseYear,
    lastMessageBody, lastMessageSenderId, unreadCount, lastReadSeq, otherReadSeq, otherDeliveredSeq
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateConversation:
UPDATE ConversationEntity SET
    type = ?,
    lastMessageAt = ?,
    otherId = ?,
    otherUsername = ?,
    otherFullName = ?,
    otherAvatarUrl = ?,
    otherOnline = ?,
    otherLastSeenAt = ?,
    otherUniversityId = ?,
    otherGender = ?,
    otherCourseYear = ?,
    lastMessageBody = ?,
    lastMessageSenderId = ?,
    unreadCount = ?,
    -- Kursorlar ORTGA surilmasin: WS orqali allaqachon oldinga ketgan bo'lishi mumkin.
    lastReadSeq = max(lastReadSeq, :lastReadSeq),
    otherReadSeq = max(otherReadSeq, :otherReadSeq),
    otherDeliveredSeq = max(otherDeliveredSeq, :otherDeliveredSeq)
WHERE id = :id;

-- WS `message:new` — ro'yxatdagi qatorni yangilaydi (suhbat allaqachon keshda bo'lsa).
touchConversation:
UPDATE ConversationEntity
SET lastMessageBody = ?, lastMessageSenderId = ?, lastMessageAt = ?, unreadCount = unreadCount + ?
WHERE id = ?;

-- WS `presence:update` — onlayn holati (bir odam bir nechta suhbatda bo'lishi mumkin emas,
-- lekin so'rov baribir `otherId` bo'yicha ketadi).
setPresence:
UPDATE ConversationEntity SET otherOnline = ?, otherLastSeenAt = ? WHERE otherId = ?;

markRead:
UPDATE ConversationEntity SET unreadCount = 0, lastReadSeq = max(lastReadSeq, ?) WHERE id = ?;

-- WS `message:read` (server → klient) — suhbatdosh qayergacha o'qigani.
setOtherReadSeq:
UPDATE ConversationEntity SET otherReadSeq = max(otherReadSeq, ?) WHERE id = ?;

-- WS `message:delivered` (server → klient) — suhbatdoshning qurilmasi qayergacha olgani.
setOtherDeliveredSeq:
UPDATE ConversationEntity SET otherDeliveredSeq = max(otherDeliveredSeq, ?) WHERE id = ?;

setArchived:
UPDATE ConversationEntity SET archived = ? WHERE id = ?;

deleteConversation:
DELETE FROM ConversationEntity WHERE id = ?;

clearConversations:
DELETE FROM ConversationEntity;

-- --- Xabarlar ---------------------------------------------------------------------------

-- Eskidan yangiga. Yuborilayotgani (`seq = 0`) eng oxirida.
selectMessages:
SELECT * FROM MessageEntity
WHERE conversationId = ?
ORDER BY (seq = 0), seq ASC, createdAt ASC;

-- Tarixni yuqoriga yuklash kursori (`?before=`). `min()`/`max()` o'rniga ORDER BY + LIMIT:
-- agregat ustun SQLDelight'da qo'shimcha o'rov klass hosil qiladi, bu esa oddiy `Long?`.
minSeq:
SELECT seq FROM MessageEntity WHERE conversationId = ? AND seq > 0 ORDER BY seq ASC LIMIT 1;

-- Qayta ulanishda yetishib olish kursori (`?after=`).
maxSeq:
SELECT seq FROM MessageEntity WHERE conversationId = ? ORDER BY seq DESC LIMIT 1;

selectMessageById:
SELECT * FROM MessageEntity WHERE id = ?;

upsertMessage:
INSERT OR REPLACE INTO MessageEntity(
    id, conversationId, senderId, seq, type, body, createdAt, clientMsgId, status,
    attachmentUrl, attachmentThumbUrl, attachmentWidth, attachmentHeight, albumId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setMessageStatus:
UPDATE MessageEntity SET status = ? WHERE id = ?;

-- Rasm yuklanib bo'lgach: optimistik qatorning tanasi va biriktirmasi haqiqiy havolaga
-- almashadi. Qator o'chirilmaydi — `id` o'zgarmagani uchun ekranda sakrash bo'lmaydi.
setMessageMedia:
UPDATE MessageEntity SET body = ?, attachmentUrl = ?, attachmentThumbUrl = ? WHERE id = ?;

-- Optimistik qator ack kelganda serverning haqiqiy id/seq'iga almashadi.
deleteMessage:
DELETE FROM MessageEntity WHERE id = ?;

-- `message:new` o'z xabarimiz bo'lib qaytganda optimistik nusxani olib tashlaydi.
-- Server `message:new` da `clientMsgId` yubormaydi, shuning uchun moslik matn bo'yicha —
-- ack ham shu ishni qiladi, bu esa ack'dan OLDIN kelgan holat uchun.
deleteSendingByBody:
DELETE FROM MessageEntity
WHERE conversationId = ? AND status = 'SENDING' AND body = ?;

clearConversationMessages:
DELETE FROM MessageEntity WHERE conversationId = ?;

clearMessages:
DELETE FROM MessageEntity;
