<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Oflayn push (03-WEBSOCKET.md §10). Android 13+ da bu ruxsat ish vaqtida so'raladi
         (`MainActivity`); berilmasa ilova ishlayveradi, faqat bildirishnoma ko'rinmaydi. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Chegirmagacha bo'lgan masofani ko'rsatish uchun (Chegirmalar bo'limi).
         Ixtiyoriy: ruxsat berilmasa e'lonlar masofasiz ko'rsatiladi. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Chatdagi ovozli xabar. Ruxsat ish vaqtida, mikrofon tugmasi bosilganda so'raladi
         (`uikit/media/AudioRecorder`); berilmasa ilova ishlayveradi, faqat ovoz yozilmaydi. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Biriktirish varag'idagi galereya to'ri (`uikit/media/DeviceGallery`). Ruxsat ish
         vaqtida, varaq ochilganda so'raladi. ⚠️ Berilmasa ham rasm yuborish ishlaydi:
         varaqdagi «Galereya» tizim tanlagichini ochadi, u esa ruxsat talab qilmaydi. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- ⚠️ `READ_MEDIA_VISUAL_USER_SELECTED` ATAYLAB YO'Q. U e'lon qilinsa Android 14+ da
         tizim oynasida «faqat tanlanganlar» varianti paydo bo'ladi va foydalanuvchi uni
         bosgach to'rda butun galereya emas, faqat o'sha bir nechta rasm ko'rinadi — bu
         "rasmlarim qani?" degan savolni tug'diradi. Bizga to'liq ro'yxat kerak. -->
    <!-- Android 12 va undan eskilarida media ruxsatlari hali ajratilmagan edi. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- ===================== Qo'ng'iroq (1:1 audio/video) ===================== -->

    <!-- Video qo'ng'iroqda kamera. Ruxsat ish vaqtida, qo'ng'iroq tugmasi bosilganda
         so'raladi (`rememberCallPermissions`). ⚠️ Rad etilsa qo'ng'iroq TO'XTAMAYDI —
         ovozli bo'lib davom etadi; majburiysi faqat mikrofon. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Qo'ng'iroq davomida ilova fonga o'tsa ham mikrofon/kamera ishlashda davom etsin.
         ⚠️ Android 14+ da bularsiz tizim fonda mikrofonni JIMGINA o'chirib qo'yadi:
         suhbatdosh sizni eshitmay qoladi va hech qanday xato ko'rinmaydi. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Kiruvchi qo'ng'iroq ekranini yoqilmagan telefonda ham ko'rsatish. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Kiruvchi qo'ng'iroqning TO'LIQ EKRANLI oynasi. Android 14+ da bu ruxsat faqat
         qo'ng'iroq va budilnik ilovalariga avtomatik beriladi; berilmasa bildirishnoma
         oddiy "heads-up" bo'lib chiqadi — qo'ng'iroq baribir ko'rinadi va eshitiladi. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Kiruvchi qo'ng'iroqda tebranish (tebranish rejimida yagona bildirgich). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".StudentClubApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentClub.Splash">

        <!-- Yagona Activity — to'g'ridan-to'g'ri talaba oqimi (rol tanlash yo'q).
             `singleTop`: push bosilganda ilovaning ikkinchi nusxasi ochilmasin — mavjud
             oyna `onNewIntent` orqali suhbat id'sini oladi. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Jonli qo'ng'iroq xizmati — ilova fonda bo'lganda mikrofon/kamerani tirik
             ushlab turadi va bildirishnomada "Qo'ng'iroq davom etmoqda" ko'rsatadi.
             `foregroundServiceType` da ikkalasi ham: ovozli qo'ng'iroqda kamera
             ishlatilmaydi, lekin tur e'lon qilinmasa video qo'ng'iroqda kamera fonda
             o'chib qolardi. -->
        <service
            android:name="dev.feature.calls.data.session.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Kiruvchi qo'ng'iroq bildirishnomasidagi "Javob berish" / "Rad etish".
             `exported="false"` — freym faqat ilovaning o'z bildirishnomasidan keladi. -->
        <receiver
            android:name="dev.feature.calls.data.session.CallActionReceiver"
            android:exported="false" />

        <!-- FCM: token yangilanishi va old plandagi xabarlar. -->
        <service
            android:name=".push.StudentClubMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Fonda kelgan `notification` xabarlarini tizim shu ikona va kanal bilan chizadi.
             Kanal `PushNotifications.CHANNEL_CHAT` bilan bir xil bo'lishi SHART, aks holda
             Android 8+ da bildirishnoma ko'rinmay qoladi. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chat_messages" />
    </application>
</manifest>
